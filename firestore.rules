rules_version = '2';

// Firebase 콘솔 > Firestore Database > 규칙(Rules) 탭에 이 내용을 그대로 붙여넣고 "게시(Publish)"하세요.
//
// - 읽기(read): 누구나 가능 (기록을 보는 것은 링크를 아는 모든 사람에게 열려있어요)
// - 쓰기(write): 로그인(= /api/login 에서 PIN 인증에 성공)한 사람만 가능
service cloud.firestore {
  match /databases/{database}/documents {
    match /tennisRecord/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 그 외 경로는 모두 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
